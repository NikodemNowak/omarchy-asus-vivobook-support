{
  "vivobook": {
    "icon": "󰌢",
    "label": "ASUS Vivobook S 16"
  },
  "vivobook.keyboard": {
    "icon": "󰌌",
    "label": "Podświetlenie klawiatury"
  },
  "vivobook.displays": {
    "icon": "󰍹",
    "label": "Przełączanie ekranów"
  },
  "vivobook.microphone": {
    "icon": "󰍬",
    "label": "Tryby mikrofonu"
  },
  "vivobook.emoji": {
    "icon": "",
    "label": "Emotki",
    "action": "omarchy-shell shell toggle omarchy.emojis"
  },
  "vivobook.power": {
    "icon": "󰐥",
    "label": "Tryb pracy"
  },
  "vivobook.hardware": {
    "icon": "󰌢",
    "label": "Pozostałe urządzenia",
    "target": "trigger.hardware"
  },
  "vivobook.bluetooth": {
    "icon": "󰂯",
    "label": "Bluetooth",
    "action": "omarchy-shell shell toggle omarchy.bluetooth"
  },
  "vivobook.power.power-saver": {
    "label": "Cichy / oszczędny",
    "action": "omarchy-powerprofiles-set autodetect power-saver",
    "checked": "[[ $(powerprofilesctl get) == power-saver ]]"
  },
  "vivobook.power.balanced": {
    "label": "Zrównoważony",
    "action": "omarchy-powerprofiles-set autodetect balanced",
    "checked": "[[ $(powerprofilesctl get) == balanced ]]"
  },
  "vivobook.power.performance": {
    "label": "Wydajny",
    "action": "omarchy-powerprofiles-set autodetect performance",
    "checked": "[[ $(powerprofilesctl get) == performance ]]"
  },
  "vivobook.keyboard.level0": {
    "label": "Wyłączone (0/3)",
    "action": "\"$HOME/.local/share/asus-vivobook-support/set-keyboard-level.sh\" 0",
    "checked": "[[ $(brightnessctl -d asus::kbd_backlight get) == 0 ]]"
  },
  "vivobook.keyboard.level1": {
    "label": "1/3",
    "action": "\"$HOME/.local/share/asus-vivobook-support/set-keyboard-level.sh\" 1",
    "checked": "[[ $(brightnessctl -d asus::kbd_backlight get) == 1 ]]"
  },
  "vivobook.keyboard.level2": {
    "label": "2/3",
    "action": "\"$HOME/.local/share/asus-vivobook-support/set-keyboard-level.sh\" 2",
    "checked": "[[ $(brightnessctl -d asus::kbd_backlight get) == 2 ]]"
  },
  "vivobook.keyboard.level3": {
    "label": "3/3",
    "action": "\"$HOME/.local/share/asus-vivobook-support/set-keyboard-level.sh\" 3",
    "checked": "[[ $(brightnessctl -d asus::kbd_backlight get) == 3 ]]"
  },
  "vivobook.displays.internal": {
    "label": "Tylko ekran laptopa",
    "action": "\"$HOME/.local/share/asus-vivobook-support/display-mode.sh\" internal"
  },
  "vivobook.displays.extend": {
    "label": "Rozszerz pulpit",
    "action": "\"$HOME/.local/share/asus-vivobook-support/display-mode.sh\" extend"
  },
  "vivobook.displays.mirror": {
    "label": "Klonuj ekran",
    "action": "\"$HOME/.local/share/asus-vivobook-support/display-mode.sh\" mirror",
    "disabled": "! omarchy-hw-external-monitors"
  },
  "vivobook.displays.external": {
    "label": "Tylko ekran zewnętrzny",
    "action": "\"$HOME/.local/share/asus-vivobook-support/display-mode.sh\" external",
    "disabled": "! omarchy-hw-external-monitors"
  },
  "vivobook.displays.brightness": {
    "label": "Jasność i ustawienia ekranu",
    "action": "omarchy-shell shell toggle omarchy.monitor"
  },
  "vivobook.microphone.normal": {
    "label": "Zwykły mikrofon",
    "action": "\"$HOME/.local/share/asus-vivobook-support/microphone-mode.py\" normal"
  },
  "vivobook.microphone.conference": {
    "label": "Rozmowa: redukcja echa",
    "action": "\"$HOME/.local/share/asus-vivobook-support/microphone-mode.py\" conference",
    "description": "PipeWire / WebRTC; uruchom rozmowę po wybraniu trybu"
  },
  "vivobook.microphone.settings": {
    "label": "Głośność i urządzenia",
    "action": "omarchy-shell shell toggle omarchy.audio"
  },
  "vivobook.battery": {
    "icon": "󰁹",
    "label": "Limit ładowania (bieżąca sesja)"
  },
  "vivobook.battery.level60": {
    "label": "60%",
    "action": "\"$HOME/.local/share/asus-vivobook-support/charge-limit.py\" 60",
    "checked": "[[ $(cat /sys/class/power_supply/BAT1/charge_control_end_threshold) == 60 ]]"
  },
  "vivobook.battery.level80": {
    "label": "80%",
    "action": "\"$HOME/.local/share/asus-vivobook-support/charge-limit.py\" 80",
    "checked": "[[ $(cat /sys/class/power_supply/BAT1/charge_control_end_threshold) == 80 ]]"
  },
  "vivobook.battery.level100": {
    "label": "100%",
    "action": "\"$HOME/.local/share/asus-vivobook-support/charge-limit.py\" 100",
    "checked": "[[ $(cat /sys/class/power_supply/BAT1/charge_control_end_threshold) == 100 ]]"
  },
  "vivobook.microphone.gain": {
    "label": "Usuń przesterowanie mikrofonu",
    "action": "\"$HOME/.local/share/asus-vivobook-support/fix-microphone-gain.sh\" --persist"
  }
}
