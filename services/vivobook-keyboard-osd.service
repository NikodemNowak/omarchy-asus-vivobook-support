[Unit]
Description=ASUS keyboard hardware brightness OSD
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/sys/class/leds/asus::kbd_backlight/brightness_hw_changed

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/asus-vivobook-support/keyboard-observer.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
