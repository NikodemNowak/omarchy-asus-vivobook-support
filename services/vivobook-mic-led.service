[Unit]
Description=Synchronize ASUS microphone mute LED with PipeWire
PartOf=graphical-session.target
After=pipewire-pulse.service graphical-session.target

[Service]
ExecStart=/bin/bash %h/.local/share/asus-vivobook-support/mic-led-sync.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
